            "body": {
              "mode": "raw",
              "raw": "{\n  \"Code\": \"MFG\",\n  \"Name\": \"制造车间\",\n  \"U_IsDefault\": \"Y\",\n  \"U_IsCloseDif\": \"Y\",\n  \"U_Descr\": \"旧 0312：成本中心不是 P017 的费用；关单差异也进这个池（Q10）\",\n  \"MTC_CA_POOL1Collection\": [],\n  \"MTC_CA_POOL2Collection\": [\n    {\n      \"U_MatchBy\": \"GRPTYPE\",\n      \"U_MatchVal\": \"B\",\n      \"U_WorTypes\": \"10,20,30,40\",\n      \"U_Descr\": \"车间类别 B（旧 0312 物料组 102）\"\n    },\n    {\n      \"U_MatchBy\": \"GRPTYPE\",\n      \"U_MatchVal\": \"C\",\n      \"U_WorTypes\": \"10,20,30,40\",\n      \"U_Descr\": \"车间类别 C（旧 0312 物料组 103）\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
