{
  "info": {
    "name": "MTC_CA 成本配置初始数据",
    "description": "费用池 2 条 + 计算参数 38 条，经 Service Layer 写入 B1 UDO。先改集合变量，再用 Runner 按顺序执行。已存在的 Code 会返回 400/-2035，属正常（不覆盖）。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://B1服务器:50000/b1s/v1"
    },
    {
      "key": "companyDB",
      "value": "公司库名"
    },
    {
      "key": "user",
      "value": "manager"
    },
    {
      "key": "password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/Login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"CompanyDB\": \"{{companyDB}}\",\n  \"UserName\": \"{{user}}\",\n  \"Password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('成功（201 新建 / 200 / 204）', () => pm.expect(pm.response.code).to.be.oneOf([200,201,204]));"
            ]
          }
        }
      ]
    },
    {
