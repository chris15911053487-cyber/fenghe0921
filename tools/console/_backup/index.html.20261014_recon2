        return `<td${typeof v === "number" ? ' class="n"' : ""}>${f ? f(v, x) : typeof v === "number" && !["StepNo","RowCnt","IssueCnt","Lines","Cnt","NoReason","Iter"].includes(cols[k]) ? n2(v) : esc(v)}</td>`; }).join("") + "</tr>").join("")
