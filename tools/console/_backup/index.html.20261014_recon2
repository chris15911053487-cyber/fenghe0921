const SQ_HINT = req => `<div class="empty">${req ? "输入条件后点“查询”。" : "输入条件后点“查询”；不输入条件直接点“查询”= 查全部，数据多时较慢。"}</div>`;
async function searchList(sel, action, args, title, opt = {}, ph = "编码开头"){
  const box = $(sel);
  box.innerHTML = `<div class="bar"><h3 style="margin:0">${esc(title)}</h3><span class="sp"></span><input type="text" id="sq" placeholder="${esc(ph)}" maxlength="50" value="${esc(sqGet(title))}"><button class="btn" id="sgo">查询</button><button class="btn" id="scsv">导出</button></div><div id="sres"></div>`;
  let last = null;
  const go = async () => {
    const v = $("#sq").value.trim();
    if (!/^[A-Za-z0-9_.\-\/]{0,50}$/.test(v)) { $("#sres").innerHTML = errBox("只能输入字母、数字、下划线、点、横线和斜线"); return; }
    if (opt.require && !v) { $("#sres").innerHTML = errBox("请先输入查询条件"); return; }
    sqSet(title, v);
    $("#sres").innerHTML = `<div class="empty">加载中…</div>`;
    try { show(await q(action, {...args, q:v})); } catch (e) { $("#sres").innerHTML = errBox(e); }
  };
  const show = r => {
    last = r; $("#sres").innerHTML = table(last, opt);
    if (opt.onRow) bindRows($("#sres"), last, opt.onRow);
  };
  $("#sgo").onclick = go; $("#sq").onkeydown = e => { if (e.key === "Enter") go(); };
  $("#scsv").onclick = () => last && csv(last, `${title}_${args.runId}`);
  const c = qCached(action, {...args, q:sqGet(title)});
  if (c) show(c); else $("#sres").innerHTML = SQ_HINT(opt.require);
}

