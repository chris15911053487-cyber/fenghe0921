<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>成本执行台</title>
<style>
:root{
  --hdr:52px;
  --bg:#F3F6F5; --surface:#FFFFFF; --ink:#16222B; --muted:#5B6970; --line:#CCD5D3; --soft:#E6ECEA;
  --accent:#0E7A6B; --accent-ink:#FFFFFF; --warn:#B9740F; --warn-bg:#FBF1DF;
  --crit:#B03F2C; --crit-bg:#F8E5E1; --good:#2F7D46; --good-bg:#E3F1E7; --run:#2D5F6E; --run-bg:#E3EEF0;
  --sans:"IBM Plex Sans","PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",system-ui,sans-serif;
  --mono:"IBM Plex Mono","SFMono-Regular",Menlo,Consolas,"PingFang SC","Microsoft YaHei",monospace;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#11181C; --surface:#182126; --ink:#E4ECEA; --muted:#93A3A8; --line:#2E3B40; --soft:#212C31;
    --accent:#3DB39F; --accent-ink:#0B1A17; --warn:#E3A74A; --warn-bg:#3A2D17;
    --crit:#E87B67; --crit-bg:#3D211C; --good:#6CC488; --good-bg:#1C3324; --run:#7FB6C6; --run-bg:#1D3138;
  }
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 var(--sans)}
button,input,select{font:inherit;color:inherit}
header.top{display:flex;align-items:center;gap:8px 16px;height:var(--hdr);padding:0 16px;background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
header.top h1{font-size:16px;margin:0;font-weight:700;white-space:nowrap;letter-spacing:.02em}
header.top .sp{flex:1}
.conn{display:flex;flex-wrap:wrap;gap:2px 14px;color:var(--muted);font-size:12.5px;justify-content:flex-end}
.conn b{color:var(--ink);font-weight:600}
.schema{font-family:var(--mono);background:var(--warn-bg);color:var(--warn);padding:1px 8px;border-radius:4px;font-weight:600}
.layout{display:grid;grid-template-columns:184px minmax(0,1fr);min-height:calc(100vh - var(--hdr))}
.layout>*{min-width:0}
main{padding:16px 20px 24px;max-width:1680px;width:100%}
/* 左侧分组导航 */
.side{position:sticky;top:var(--hdr);align-self:start;max-height:calc(100vh - var(--hdr));overflow:auto;padding:10px 8px 20px;border-right:1px solid var(--line);background:var(--surface)}
.side .grp{font-size:11.5px;color:var(--muted);font-weight:600;letter-spacing:.06em;padding:10px 10px 2px}
.side .grp:first-child{padding-top:4px}
.side button{display:block;width:100%;text-align:left;border:0;background:transparent;padding:4px 10px;border-radius:6px;cursor:pointer;color:var(--ink);font-size:13.5px}
.side button:hover{background:var(--soft)}
.side button.on{background:var(--run-bg);color:var(--accent);font-weight:600;box-shadow:inset 3px 0 0 var(--accent)}
.navbtn{display:none}
/* 顶栏：运行切换、进行中的任务 */
.runsw{position:relative}
.runbtn{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--bg);border-radius:6px;padding:5px 10px;cursor:pointer;max-width:420px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.runbtn:hover{border-color:var(--accent)}
.runbtn .caret{color:var(--muted);font-size:11px}
.pop{position:absolute;top:calc(100% + 6px);left:0;width:min(420px,calc(100vw - 32px));background:var(--surface);border:1px solid var(--line);border-radius:8px;box-shadow:0 8px 28px rgba(0,0,0,.16);padding:10px 0 0;z-index:30}
.pop .bar{padding:0 12px}
.jobpill{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;padding:3px 10px;border-radius:12px;background:var(--run-bg);color:var(--run);text-decoration:none;font-weight:600;white-space:nowrap}
.jobpill.ok{background:var(--good-bg);color:var(--good)} .jobpill.err{background:var(--crit-bg);color:var(--crit)}
/* 运行概况 */
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:14px}
.tiles:empty{display:none}
.tile{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:8px 12px;min-width:0}
.tile>span{display:block;color:var(--muted);font-size:12px}
.tile>b{display:block;font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tile.wide{grid-column:1/-1;font-size:13px;color:var(--muted)}
.tile.wide:empty{display:none}
.form .row label{min-width:64px}
@media (max-width:900px){
  .layout{grid-template-columns:minmax(0,1fr)}
  .side{display:none;position:fixed;top:0;left:0;bottom:0;width:220px;max-height:none;padding-top:calc(var(--hdr) + 8px);z-index:15;box-shadow:4px 0 20px rgba(0,0,0,.18)}
  .side.open{display:block}
  .navbtn{display:inline-block}
  .conn{display:none}
  main{padding:12px 16px 20px}
  header.top{gap:8px}
  header.top h1{display:none}
  .runbtn{max-width:56vw;padding:4px 8px}
  header.top .btn{white-space:nowrap;padding:5px 10px}
  #goRun{display:none}
  .tiles{grid-template-columns:repeat(auto-fill,minmax(104px,1fr));gap:6px}
  .tile{padding:6px 10px}
  .tile>b{font-size:14px}
}
.card{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:16px;margin-bottom:16px;min-width:0}
.card h2{font-size:16px;margin:0 0 12px;font-weight:600}
.card h3{font-size:14px;margin:14px 0 6px;font-weight:600}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:8px}
.row label{color:var(--muted);font-size:13px;min-width:52px}
select,input[type=text]{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:5px 8px;min-width:0}
input[type=text]{width:160px}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:6px;overflow:hidden}
.seg button{border:0;background:transparent;padding:5px 12px;cursor:pointer}
.seg button.on{background:var(--accent);color:var(--accent-ink)}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:6px;padding:6px 14px;cursor:pointer}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);font-weight:600}
.btn:disabled{opacity:.45;cursor:not-allowed}
.hint{color:var(--muted);font-size:12.5px;margin:6px 0 0}
.runs{max-height:60vh;overflow:auto;border-top:1px solid var(--soft)}
.runs div.r{padding:7px 12px;border-bottom:1px solid var(--soft);cursor:pointer;display:grid;grid-template-columns:auto 1fr auto;gap:2px 8px;font-size:13px}
.runs div.r:hover{background:var(--soft)}
.runs div.r.sel{background:var(--run-bg)}
.runs .id{font-family:var(--mono);color:var(--muted)}
.runs .m{grid-column:1/-1;color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chip{display:inline-block;font-size:12px;padding:0 7px;border-radius:10px;font-weight:600;white-space:nowrap}
.s-OK,.s-PASS,.s-CHECKED{background:var(--good-bg);color:var(--good)}
.s-WARN{background:var(--warn-bg);color:var(--warn)}
.s-FAIL,.s-BLOCKED,.s-NOCONV{background:var(--crit-bg);color:var(--crit)}
.s-RUNNING{background:var(--run-bg);color:var(--run)}
.s-SKIP,.s-NA{background:var(--soft);color:var(--muted)}
.tw{overflow:auto;max-height:62vh;border:1px solid var(--soft);border-radius:6px}
table{border-collapse:collapse;width:100%;font-size:13px}
th,td{padding:5px 8px;border-bottom:1px solid var(--soft);text-align:left;white-space:nowrap;vertical-align:top}
th{position:sticky;top:0;background:var(--soft);font-weight:600;z-index:1}
td.n{text-align:right;font-family:var(--mono);font-variant-numeric:tabular-nums}
td.wrap{white-space:normal;min-width:240px}
tr.click{cursor:pointer}
tr.click:hover td{background:var(--soft)}
tr.sel td{background:var(--run-bg)}
tr.sub td{font-weight:600;background:var(--soft)}
tr.tot td{font-weight:700;background:var(--run-bg)}
.neg{color:var(--crit)}
.empty{color:var(--muted);padding:18px;text-align:center}
.msg{padding:8px 10px;border-radius:6px;margin:8px 0;font-size:13px}
.msg.err{background:var(--crit-bg);color:var(--crit)}
.msg.ok{background:var(--good-bg);color:var(--good)}
.msg.info{background:var(--run-bg);color:var(--run)}
.prog{border:1px solid var(--line);border-radius:8px;padding:10px 12px;margin:8px 0;font-size:13px}
.prog .ph{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}
.prog .ph .sp{flex:1}
.pbar{height:6px;background:var(--soft);border-radius:3px;overflow:hidden;margin:8px 0 6px}
.pbar i{display:block;height:100%;background:var(--accent);transition:width .4s}
.psteps{list-style:none;margin:0;padding:0}
.psteps li{display:grid;grid-template-columns:18px 1fr auto;gap:0 6px;padding:2px 0;align-items:start}
.psteps .ic{font-weight:700;text-align:center;line-height:20px}
.psteps .t{color:var(--muted);font-family:var(--mono);font-size:12px}
.psteps .note{grid-column:2/-1;color:var(--run);font-size:12px;overflow-wrap:anywhere}
.psteps li.todo{color:var(--muted)}
.psteps li.cur{font-weight:600}
.psteps li.ok .ic{color:var(--good)} .psteps li.warn .ic{color:var(--warn)} .psteps li.fail .ic{color:var(--crit)}
.spin{display:inline-block;width:10px;height:10px;margin-top:5px;border:2px solid var(--run-bg);border-top-color:var(--run);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.spin{animation:none;border-color:var(--run)}.pbar i{transition:none}}
.summary{display:flex;flex-wrap:wrap;gap:8px 18px;margin-bottom:10px;font-size:13px;color:var(--muted)}
.summary b{color:var(--ink)}
.bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:8px}
.bar .sp{flex:1}
dialog{border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--ink);padding:18px;max-width:440px;width:calc(100% - 32px)}
dialog::backdrop{background:rgba(0,0,0,.35)}
dialog h3{margin:0 0 10px;font-size:16px}
dialog table{margin:8px 0 12px}
dialog td{border:0;padding:3px 8px 3px 0}
dialog input{width:100%}
.mono{font-family:var(--mono)}
.ai-u{border-left:3px solid var(--accent);padding:4px 10px;margin:8px 0}
.report h1{font-size:19px;margin:6px 0 8px}.report h2{font-size:16px;margin:20px 0 6px}.report h3{font-size:14px}.report ul{margin:4px 0 8px;padding-left:20px}
.report table{margin:6px 0 14px}.report td.n{text-align:right;font-family:var(--mono)}.report .foot{color:var(--muted);font-size:12px}
.detail{margin-top:14px;border-top:2px solid var(--accent);padding-top:10px}
.kv{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:6px 14px;margin:0 0 10px;font-size:13px}
.kv div{display:flex;justify-content:space-between;gap:8px;border-bottom:1px dotted var(--soft);padding:2px 0}
.kv span{color:var(--muted)}
.kv b{font-weight:600;text-align:right}
.subtabs{display:flex;flex-wrap:wrap;gap:4px;margin:4px 0 8px}
.subtabs button{border:1px solid var(--line);background:transparent;border-radius:14px;padding:3px 12px;cursor:pointer;font-size:13px}
.subtabs button.on{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
</style>
</head>
<body>
<header class="top">
  <h1>成本执行台</h1>
  <div class="runsw" id="runSw">
    <button class="runbtn" id="runBtn" aria-haspopup="true"><span id="runBtnTxt">选择一次运行</span> <span class="caret">▾</span></button>
    <div class="pop" id="runPop" hidden>
      <div class="bar"><b>运行记录</b><span class="sp"></span><button class="btn" id="btnRefresh">刷新</button></div>
      <div class="runs" id="runs"></div>
    </div>
  </div>
  <a href="#steps" class="jobpill" id="jobPill" hidden></a>
  <span class="sp"></span>
  <div class="conn" id="conn">连接中…</div>
  <button class="btn primary" id="goRun">发起计算</button>
  <button class="btn navbtn" id="navBtn" aria-label="菜单">☰ 菜单</button>
</header>

<div class="layout">
  <nav class="side" id="tabs">
    <div class="grp">本次运行</div>
    <button data-t="steps">步骤</button>
    <button data-t="checks">校验</button>
    <button data-t="qcp">期初价维护</button>
    <div class="grp">存货</div>
    <button data-t="items">物料单价</button>
    <button data-t="inv">收发存汇总</button>
    <button data-t="ledger">收发存明细</button>
    <div class="grp">订单与费用</div>
    <button data-t="orders">订单成本</button>
    <button data-t="wip">在产品</button>
    <button data-t="exp">费用归集</button>
    <button data-t="pool">费用分摊</button>
    <div class="grp">财务</div>
    <button data-t="goods">发出商品</button>
    <button data-t="ap">应付暂估</button>
    <button data-t="jdt">凭证</button>
    <button data-t="recon">财务对账</button>
    <div class="grp">比对与说明</div>
    <button data-t="cmp">新旧比对</button>
    <button data-t="kpi">运行比较</button>
    <button data-t="report">计算说明</button>
    <div class="grp">操作</div>
    <button data-t="run">发起计算</button>
    <button data-t="scen">模拟场景</button>
    <button data-t="boot">期初承接</button>
    <div class="grp">配置与帮助</div>
    <button data-t="b1cfg">B1 维护数据</button>
    <button data-t="manual">说明书</button>
    <button data-t="ai">AI 助手</button>
  </nav>

  <main>
    <div class="tiles" id="runHead"></div>

    <section class="card page" id="page-run" hidden>
      <h2>发起计算</h2>
      <div class="form">
        <div class="row"><label>账期</label><select id="fc"></select></div>
        <div class="row"><label>类型</label>
          <span class="seg" id="rtSeg"><button data-v="F" class="on">正式</button><button data-v="S">模拟</button></span>
        </div>
        <div class="row" id="scenRow" hidden><label>场景</label><select id="scen"></select></div>
        <div class="row"><label>操作人</label><input type="text" id="user" maxlength="50"></div>
        <div class="row"><label></label><button class="btn primary" id="btnRun">开始计算</button><button class="btn" id="btnPre">只做计算前检查</button></div>
      </div>
      <p class="hint">依次执行：从 B1 同步费用池与归集参数 → 快照 → 计算前检查（有阻断项就停止）→ 迭代计算 → 定稿 → 计算后校验 → 新旧比对 → 发出商品 / 应付暂估 / 凭证 → 收尾。只写 MTC_CA_* 表，不改 B1 单据，不过账。</p>
      <div id="job"></div>
    </section>

    <section class="card page" id="page-scen" hidden>
      <div class="bar"><h2 style="margin:0">模拟场景</h2><span class="sp"></span><button class="btn" id="scNew">新建</button></div>
      <div class="row"><select id="scSel" style="flex:1;max-width:420px"></select><button class="btn" id="scEdit">编辑</button></div>
      <p class="hint">模拟计算（在“发起计算”里类型选“模拟”）在快照之后按场景假设调整：采购价、费用池、单位工时的百分比；结果单独保存，不影响正式结果。</p>
      <div id="scBox"></div>
    </section>

    <section class="card page" id="page-boot" hidden>
      <h2>期初承接</h2>
      <div id="bootInfo" class="hint" style="margin:0 0 10px"></div>
      <div class="row"><button class="btn" id="btnBoot">执行期初承接</button></div>
      <p class="hint">从旧框架承接账期的结果取物料期初和订单在产品（只在新框架第一次计算前做一次；重做会覆盖该账期的承接数据）。</p>
    </section>

    <section class="card" id="runCard">
      <h2 id="pageTitle"></h2>
      <div id="pane"></div>
    </section>
  </main>
</div>

<dialog id="dlg">
  <h3 id="dlgTitle"></h3>
  <table id="dlgTable"></table>
  <div id="dlgTypeWrap">
    <p class="hint" style="margin:0 0 6px">请完整输入账套名 <b class="mono" id="dlgSchema"></b> 确认：</p>
    <input type="text" id="dlgInput" autocomplete="off">
  </div>
  <div class="row" style="justify-content:flex-end;margin:14px 0 0">
    <button class="btn" id="dlgCancel">取消</button>
    <button class="btn primary" id="dlgOk" disabled>确认执行</button>
  </div>
</dialog>

<script>
"use strict";
const $ = s => document.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const H = {"X-Requested-With":"cost-console"};
async function api(path, body){
  const r = await fetch(path, body ? {method:"POST", headers:{...H, "Content-Type":"application/json"}, body:JSON.stringify(body)} : {headers:H});
  const j = await r.json();
  if (!j.ok) throw new Error(j.error || "请求失败");
  return j;
}
// 查询结果缓存：运行结束后结果不再变，同一查询第二次直接用缓存（切页签不重查）；“刷新”和计算进行中会清空。
// 依赖当前总账的财务对账另行处理（见 recon 页的“重新对账”）
const QC = new Map();
const NOCACHE = new Set(["reconSrc"]);
const qKey = (action, args) => action + "|" + JSON.stringify(args);
const cacheable = (action, args) => args.runId && !NOCACHE.has(action) && RUNS.some(r => String(r.RunId) === String(args.runId) && r.Status !== "RUNNING");
const qCached = (action, args = {}) => QC.get(qKey(action, args));
async function q(action, args = {}, fresh = false){
  const k = qKey(action, args);
  if (!fresh && QC.has(k)) return QC.get(k);
  const r = await api("/api/q", {action, args});
  if (cacheable(action, args)) QC.set(k, r);
  return r;
}
const asObjs = r => r.rows.map(x => Object.fromEntries(r.columns.map((c, i) => [c, x[i]])));

const LABEL = {
  RunId:"运行号", FcCode:"账期", RunType:"类型", Scenario:"场景", Status:"状态", Msg:"说明", StartTime:"开始", EndTime:"结束",
  StepNo:"#", StepCode:"步骤", RowCnt:"数量", Sec:"秒", Iter:"轮", MaxPriceDelta:"最大单价变化", PoolDelta:"费用池变化",
  CloseDifDelta:"关单差异变化", UnconvItems:"未收敛物料", CheckId:"编号", Stage:"阶段", Title:"校验", Result:"结果", IssueCnt:"问题数",
  IsBlock:"阻断", Purpose:"用途", TroublePath:"排查路径", SeqNo:"#", KeyCode:"对象", Info:"说明", Kind:"类别", Cnt:"差异条数",
  AbsDiff:"差异绝对值合计", NoReason:"未归因", NewVal:"新框架", OldVal:"旧框架", Diff:"差额", Reason:"原因", Note:"备注",
  ItemCode:"物料", iLevel:"层级", PriceSrc:"定价来源", Price:"单价", PMat:"材料", PMfg:"制造费用", PLab:"人工", PSub:"委外",
  OpenQty:"期初数量", InQty:"入库数量", OutQty:"出库数量", EndQty:"期末数量", EndAmount:"期末金额", Flags:"标记",
  OrderType:"单据", OrderEntry:"订单", WorType:"订单类型", PlannedQty:"计划数", RecvQty:"本期完工", CostMat:"材料", CostMfg:"制造费用",
  CostLab:"人工", CostSub:"委外", CostAmt:"完工成本", UnitCost:"单位成本", WipAmt:"在产品", CloseDifAmt:"关单差异", ClosedInFc:"本期关单",
  TransCode:"凭证代码", TransName:"名称", Lines:"行数", Debit:"借方", Credit:"贷方", NoAcct:"缺科目", LineNo:"行", RefDate:"日期",
  AcctCode:"科目", OcrCode:"成本中心", Project:"项目",
  OrderNum:"订单号", ItemName:"名称", PostDate:"下单日期", B1Status:"当前状态", CloseDate:"关闭日期", StatusAtEnd:"期末状态", InScope:"计算范围",
  CardCode:"业务伙伴", PrevRecvQty:"上期累计完工", Ratio:"结转比例", AllocMfg:"分摊制造费用", AllocLab:"分摊人工",
